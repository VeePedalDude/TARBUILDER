// TARBUILDER example: one bar per technique group, standard tuning, 100 BPM.
// Every effect used here is listed in .claude/skills/alphatab-gp7/alphatex-reference.md
\title ("Technique Sampler")
\artist ("VeePedalDude")
\tempo (100)

\track ("Guitar" "Gtr") { instrument overdrivenguitar }
\staff {tabs score}
\tuning (E4 B3 G3 D3 A2 E2)
\chord ("E" 0 0 1 2 2 0)
\chord ("A" 0 2 2 2 0 x)
\ts (4 4)
\section ("Legato + slides")
:8 5.3 7.3{h} 5.3{h} 7.2{sib} 8.2{sl} 10.2 10.2{sou} r |
\section ("Bends + vibrato")
:4 7.3{b (0 4)} 7.3{b (0 2)} 7.3{b (4 0)} 12.1{v} |
\section ("Muting + dead notes")
:8 0.6{pm} 0.6{pm} x.6 x.6 0.6{pm} 3.6 x.5 5.5 |
\section ("Harmonics + let ring")
:4 12.1{nh} 12.2{nh} 7.3{nh} (0.6{lr} 0.1{lr}) |
\section ("Rhythm")
:16 5.1{tp 16} 5.1 5.1 5.1 :8 5.2{tu 3} 7.2{tu 3} 8.2{tu 3} :4 7.3{d} :8 r |
\section ("Ties + grace")
:4 5.3 -.3 :8 5.3{gr} :4 7.3 :8 7.3{g} 5.1{ac} |
\section ("Chords")
:2 (0.6 2.5 2.4 1.3 0.2 0.1){ch "E"} (0.5 2.4 2.3 2.2 0.1){ch "A"}
